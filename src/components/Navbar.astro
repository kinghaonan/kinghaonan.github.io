---
import DarkToggle from './DarkToggle.tsx';
---
<header class="navbar">
  <div class="navbar-inner">
    <a class="navbar-logo" href="/">
      <img src="/logo.jpg" alt="Ki Haonan" width="36" height="36" />
      <span class="site-name">King Haonan</span>
    </a>
    <button class="icon-btn navbar-toggle" aria-label="展开菜单" onclick="document.querySelector('.navbar-menu').classList.toggle('is-open')">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <nav class="navbar-menu">
      <div class="item"><a href="/about/">个人介绍</a></div>
      <div class="item">
        <button type="button">文档 <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></button>
        <div class="dropdown">
          <a href="/categories/blog/">博客</a>
          <a href="/categories/project/">项目</a>
          <a href="/my-quartz-site/">笔记</a>
        </div>
      </div>
      <div class="item"><a href="/archives/">归档</a></div>
      <div class="item"><a href="/faqs/">联系我</a></div>
      <div class="item">
        <button type="button">更多 <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg></button>
        <div class="dropdown">
          <a href="/tags/">标签云</a>
          <a href="https://github.com/kinghaonan/kinghaonan.github.io" target="_blank" rel="noopener">本站源码</a>
        </div>
      </div>
    </nav>
    <div class="navbar-actions">
      <button class="search-input-mini" onclick="window.dispatchEvent(new CustomEvent('open-search'))" aria-label="搜索">搜索…</button>
      <button class="icon-btn" onclick="window.dispatchEvent(new CustomEvent('open-search'))" aria-label="搜索">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </button>
      <DarkToggle client:load />
    </div>
  </div>
</header>
