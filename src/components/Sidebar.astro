---
import { getCollection } from 'astro:content';
import { tagUrl } from '../consts';
import Icon from './Icon.astro';

interface Props {
  headings?: { depth: number; slug: string; text: string }[];
  widgets?: string[];
}

const { headings = [], widgets = ['blogger', 'quick_links', 'toc', 'categories', 'tagcloud', 'webinfo'] } = Astro.props;

const posts = await getCollection('posts');
const catCount: Record<string, number> = {};
const tagCount: Record<string, number> = {};
let latest = 0;
for (const p of posts) {
  for (const c of p.data.categories || []) catCount[c] = (catCount[c] || 0) + 1;
  for (const t of p.data.tags || []) tagCount[t] = (tagCount[t] || 0) + 1;
  latest = Math.max(latest, p.data.date?.getTime() || 0);
}
const cats = Object.entries(catCount).sort((a, b) => b[1] - a[1]);
const topTags = Object.entries(tagCount).sort((a, b) => b[1] - a[1]).slice(0, 14);
const runDays = Math.floor((Date.now() - new Date('2020-01-01').getTime()) / 86400000);
const lastupd = latest ? new Date(latest).toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10);
const tocItems = headings.filter((h) => h.depth >= 2 && h.depth <= 5);
const has = (w: string) => widgets.includes(w);
---
<aside class="sidebar">
  {has('blogger') && (
    <div class="widget card glass widget-blogger">
      <img class="avatar" src="/logo.jpg" alt="Ki Haonan" width="110" height="110" loading="lazy" />
      <div class="nick">Ki Haonan</div>
      <div class="sub">航空航天 · 轨道力学</div>
      <div class="poem" id="jinrishici" title="今日诗词">正是江南好风景，落花时节又逢君。</div>
      <div class="socials">
        <a href="https://github.com/kinghaonan" target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-1.97c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.35.77 1.05.77 2.12v3.14c0 .31.21.68.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
        </a>
        <a href="mailto:kihaonan@126.com" aria-label="邮箱">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
        </a>
        <a href="/atom.xml" aria-label="RSS">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M4 4.5a15.5 15.5 0 0 1 15.5 15.5h-3A12.5 12.5 0 0 0 4 7.5v-3zm0 6a9.5 9.5 0 0 1 9.5 9.5h-3A6.5 6.5 0 0 0 4 13.5v-3zM5.5 18a1.75 1.75 0 1 1 0-3.5 1.75 1.75 0 0 1 0 3.5z"/></svg>
        </a>
      </div>
    </div>
  )}

  {has('quick_links') && (
    <div class="widget card glass">
      <h3 class="widget-title">快速访问</h3>
      <div class="quick-links">
        <a href="/about/"><Icon name="user" size={20} class="ico" />个人介绍</a>
        <a href="/categories/blog/"><Icon name="pen" size={20} class="ico" />博客文章</a>
        <a href="/categories/project/"><Icon name="code" size={20} class="ico" />我的项目</a>
        <a href="/categories/note/"><Icon name="file-text" size={20} class="ico" />学习笔记</a>
      </div>
    </div>
  )}

  {has('toc') && tocItems.length > 0 && (
    <nav class="widget card glass toc-widget" aria-label="文章目录">
      <h3 class="widget-title">文章目录</h3>
      <ol>
        {tocItems.map((h) => (
          <li style={`margin-left: ${(h.depth - 2) * 14}px;`}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )}

  {has('categories') && cats.length > 0 && (
    <div class="widget card glass widget-cats">
      <h3 class="widget-title">文章分类</h3>
      {cats.map(([c, n]) => (
        <div class="row"><a href={`/categories/${c}/`}>{c}</a><span class="count">({n})</span></div>
      ))}
    </div>
  )}

  {has('tagcloud') && topTags.length > 0 && (
    <div class="widget card glass">
      <h3 class="widget-title">热门标签</h3>
      <div class="widget-cloud">
        {topTags.map(([t, n]) => (
          <a href={tagUrl(t)} style={`font-size: ${Math.min(0.8 + n * 0.08, 1.15).toFixed(2)}rem;`}>{t}</a>
        ))}
      </div>
    </div>
  )}

  {has('webinfo') && (
    <div class="widget card glass webinfo">
      <h3 class="widget-title">站点统计</h3>
      <div class="row"><span>文章数目：</span><b>{posts.length} 篇</b></div>
      <div class="row"><span>最后更新：</span><b>{lastupd}</b></div>
      <div class="row"><span>建站天数：</span><b>{runDays} 天</b></div>
      <div class="row"><span>本站总访问量：</span><b id="busuanzi_value_site_pv">…</b></div>
    </div>
  )}
</aside>

<script>
  /* 今日诗词 */
  fetch('https://v1.jinrishici.com/all')
    .then((r) => r.json())
    .then((d) => {
      const el = document.getElementById('jinrishici');
      if (el && d.content) el.textContent = d.content;
    })
    .catch(() => {});
</script>
