---
import { getCollection } from 'astro:content';
import { tagUrl } from '../consts';
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';

const posts = await getCollection('posts');
const catCount: Record<string, number> = {};
const tagCount: Record<string, number> = {};
for (const p of posts) {
  for (const c of p.data.categories || []) catCount[c] = (catCount[c] || 0) + 1;
  for (const t of p.data.tags || []) tagCount[t] = (tagCount[t] || 0) + 1;
}
const cats = Object.entries(catCount).sort((a, b) => b[1] - a[1]);
---
<Base title="标签与分类 - King Haonan">
  <div class="page-shell">
    <div class="layout-grid">
      <main>
        <div class="card glass" style="padding: var(--sp-6) var(--sp-8);">
          <h1 style="font-family: var(--font-display); color: var(--accent-ink); margin: 0 0 var(--sp-4);">标签与分类</h1>
          {cats.map(([c, n]) => (
            <div style="margin-bottom: var(--sp-6);">
              <h2 style="font-size: 1.05rem; color: var(--accent-ink); margin: 0 0 var(--sp-2);">
                <a href={`/categories/${c}/`} style="color: var(--accent-ink);">{c}</a>
                <span style="color: var(--text-3); font-size: 0.8rem;"> ({n})</span>
              </h2>
              <div style="display:flex; flex-wrap:wrap; gap: var(--sp-2);">
                {posts
                  .filter((p) => (p.data.categories || []).includes(c))
                  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
                  .map((p) => (
                    <a href={`/${p.id}/`} style="padding: 3px 12px; border-radius: 8px; background: var(--bg-code); color: var(--text-2); font-size: 0.88rem;">
                      {p.data.title}
                    </a>
                  ))}
              </div>
            </div>
          ))}
          <h2 style="font-size: 1.05rem; color: var(--text-1); margin: var(--sp-8) 0 var(--sp-4);">全部标签</h2>
          <div style="display:flex; flex-wrap:wrap; gap: var(--sp-2);">
            {Object.entries(tagCount).sort((a, b) => b[1] - a[1]).map(([t, n]) => (
              <a href={`/tags/${encodeURIComponent(t)}/`} style="padding: 3px 12px; border-radius: 999px; background: rgba(201,164,92,0.1); color: var(--text-2); font-size: 0.85rem;">
                {t}<span style="color: var(--text-3); font-size: 0.75em;"> ({n})</span>
              </a>
            ))}
          </div>
        </div>
      </main>
      <Sidebar widgets={['blogger', 'quick_links', 'categories', 'tagcloud', 'webinfo']} />
    </div>
  </div>
</Base>
