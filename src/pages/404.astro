---
import Base from '../layouts/Base.astro';
---
<Base title="404 Not Found - King Haonan" noindex>
  <div class="page-shell" style="display:flex; align-items:center; justify-content:center; min-height: 70vh;">
    <div style="text-align:center;">
      <p class="v-p vp-logo" style="font-size: 4.5rem; margin: 0;">404</p>
      <p style="font-weight: 700; font-size: 1.1rem; color: var(--text-1); text-align:center;">很抱歉，您访问的页面不存在</p>
      <p style="font-size: 0.88rem; color: var(--text-3); text-align:center;">可能是输入地址有误或该地址已被删除</p>
      <p style="text-align:center; margin-top: var(--sp-6);">
        <a class="btn btn-primary" href="/">回首页</a>
        <a class="btn btn-ghost" href="/archives/">去归档</a>
      </p>
    </div>
  </div>
</Base>
