---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { PER_PAGE } from '../../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const cats = [...new Set(posts.flatMap((p) => p.data.categories || []))];
  const paths = [];
  for (const cat of cats) {
    const catPosts = posts
      .filter((p) => (p.data.categories || []).includes(cat))
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
    const lastPage = Math.ceil(catPosts.length / PER_PAGE);
    for (let n = 1; n <= lastPage; n++) {
      paths.push({
        params: { cat, page: n === 1 ? undefined : `page/${n}` },
        props: { items: catPosts.slice((n - 1) * PER_PAGE, n * PER_PAGE), currentPage: n, lastPage, cat },
      });
    }
  }
  return paths;
}

const { items, currentPage, lastPage, cat } = Astro.props;
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base title={`分类：${cat} - King Haonan`}>
  <div class="page-shell">
    <div class="layout-grid">
      <main>
        <div class="card glass" style="padding: var(--sp-6) var(--sp-8);">
          <h1 style="font-family: var(--font-display); color: var(--accent-ink); margin: 0 0 var(--sp-4);">分类：{cat}</h1>
          <ul class="arch-list">
            {items.map((p: any) => (
              <li class="item">
                <span class="date">{fmt(p.data.date)}</span>
                <a href={`/${p.id}/`}>{p.data.title}</a>
                {(p.data.tags || []).slice(0, 3).map((t: string) => <span style="color: var(--text-3); font-size: 0.8rem;">{t}</span>)}
              </li>
            ))}
          </ul>
          {lastPage > 1 && (
            <nav class="pagination">
              {currentPage > 1 && <a href={`/categories/${cat}/page/${currentPage - 1}/`}>← 上一页</a>}
              {Array.from({ length: lastPage }, (_, i) => i + 1).map((n) =>
                n === currentPage ? <span class="cur">{n}</span> : <a href={`/categories/${cat}/${n === 1 ? '' : `page/${n}/`}`}>{n}</a>
              )}
              {currentPage < lastPage && <a href={`/categories/${cat}/page/${currentPage + 1}/`}>下一页 →</a>}
            </nav>
          )}
        </div>
      </main>
      <Sidebar widgets={['blogger', 'quick_links', 'categories', 'tagcloud', 'webinfo']} />
    </div>
  </div>
</Base>
