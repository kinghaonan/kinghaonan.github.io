---
import { getCollection } from 'astro:content';
import { tagUrl } from '../consts';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';

const posts = await getCollection('posts');
const catCount: Record<string, number> = {};
const tagCount: Record<string, number> = {};
for (const p of posts) {
  for (const c of p.data.categories || []) catCount[c] = (catCount[c] || 0) + 1;
  for (const t of p.data.tags || []) tagCount[t] = (tagCount[t] || 0) + 1;
}
const cats = Object.entries(catCount).sort((a, b) => b[1] - a[1]);
const tags = Object.entries(tagCount).sort((a, b) => b[1] - a[1]);
---
<Base title="标签云与分类 - King Haonan">
  <div class="page-shell">
    <div class="layout-grid">
      <main>
        <div class="card glass" style="padding: var(--sp-6) var(--sp-8);">
          <h1 style="font-family: var(--font-display); color: var(--accent-ink); margin: 0 0 var(--sp-4);">标签云</h1>
          <div style="display:flex; flex-wrap:wrap; gap: var(--sp-2); margin-bottom: var(--sp-8);">
            {tags.map(([t, n]) => (
              <a href={`/tags/${encodeURIComponent(t)}/`} style={`font-size: ${(0.82 + Math.min(n, 12) * 0.045).toFixed(2)}rem; padding: 4px 14px; border-radius: 999px; background: rgba(201,164,92,0.1); color: var(--text-2);`}>
                {t}<span style="color: var(--text-3); font-size: 0.75em;"> ({n})</span>
              </a>
            ))}
          </div>
          <h2 style="font-size: 1.1rem; color: var(--text-1); margin: 0 0 var(--sp-4);">分类</h2>
          <div style="display:flex; flex-wrap:wrap; gap: var(--sp-2);">
            {cats.map(([c, n]) => (
              <a href={`/categories/${c}/`} style="padding: 4px 14px; border-radius: 999px; background: rgba(201,164,92,0.14); color: var(--accent-ink);">
                {c}<span style="color: var(--text-3); font-size: 0.75em;"> ({n})</span>
              </a>
            ))}
          </div>
        </div>
      </main>
      <Sidebar widgets={['blogger', 'quick_links', 'categories', 'tagcloud', 'webinfo']} />
    </div>
  </div>
</Base>
